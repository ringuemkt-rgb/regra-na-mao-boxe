# Supabase (existing project)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# -------------------------------------------------------------
# Google AdSense
# Keep disabled until the site is approved and IDs are real.
# -------------------------------------------------------------
VITE_ADSENSE_ENABLED=false
VITE_ADSENSE_PUBLISHER_ID=ca-pub-REPLACE_ME

# Preferred: configure Google's certified CMP in AdSense > Privacy & messaging.
# Alternative site-consent additionally gates the script behind the local banner,
# but it does NOT replace Google's certified CMP requirement for personalized ads
# in the EEA / UK / Switzerland.
VITE_ADSENSE_CONSENT_STRATEGY=google-cmp

# Start with manual placements. Enable Auto ads only after a controlled experiment.
VITE_ADSENSE_AUTO_ADS=false
VITE_ADSENSE_ALLOW_HOME=false
VITE_ADSENSE_DEBUG=false

# Create these units in AdSense and paste ONLY the numeric slot IDs.
VITE_ADSENSE_SLOT_ARTICLE_AFTER_INTRO=
VITE_ADSENSE_SLOT_ARTICLE_MID=
VITE_ADSENSE_SLOT_ARTICLE_END=
VITE_ADSENSE_SLOT_DESKTOP_SIDEBAR=

# -------------------------------------------------------------
# GitHub Actions secrets for AdSense Management API v2
# DO NOT put these values in Vite variables or commit them.
# Configure them in GitHub > Settings > Secrets and variables > Actions.
# -------------------------------------------------------------
# ADSENSE_CLIENT_ID=
# ADSENSE_CLIENT_SECRET=
# ADSENSE_REFRESH_TOKEN=
# ADSENSE_ACCOUNT_ID=
