# Google AdSense — BOXE DE CRIA
# Copy these values to the deployment environment. Do not commit real IDs here.

# Master switch. Keep false until the AdSense site status is Ready.
VITE_ADSENSE_ENABLED=false

# Example format only. Replace in deployment environment.
VITE_ADSENSE_PUBLISHER_ID=ca-pub-0000000000000000

# Brazil-first safe default. For EEA/UK/Switzerland personalized ads, configure
# a Google-certified CMP in AdSense Privacy & messaging before using google-cmp.
VITE_ADSENSE_CONSENT_STRATEGY=site-consent

# Start with manual slots. Enable Auto ads only after UX/revenue testing.
VITE_ADSENSE_AUTO_ADS=false
VITE_ADSENSE_ALLOW_HOME=false
VITE_ADSENSE_DEBUG=false

# Manual display units created in the AdSense dashboard.
VITE_ADSENSE_SLOT_ARTICLE_AFTER_INTRO=0000000000
VITE_ADSENSE_SLOT_ARTICLE_MID=0000000000
VITE_ADSENSE_SLOT_ARTICLE_END=0000000000
VITE_ADSENSE_SLOT_DESKTOP_SIDEBAR=0000000000

# Build-time ads.txt generator accepts pub- or ca-pub- format.
# Prefer a deployment secret/variable rather than committing the real ID.
ADSENSE_PUBLISHER_ID=pub-0000000000000000
